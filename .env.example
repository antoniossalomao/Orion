# Orion (reescrita, pacote `orion/`): copie para `.env` na pasta onde o comando roda.
# Todas as variáveis começam com ORION_. Segredos (chaves, tokens) também podem ficar no cofre do
# sistema em vez daqui. Guia completo: Memorias Do Projeto/ORION_OPERACAO.md. Este arquivo é conferido
# por um teste: toda opção de `orion/config.py` precisa aparecer aqui.
# (O legado, `Orion_Ollama/`, tem o próprio `.env.example`.)

# ── servidor ─────────────────────────────────────────────────────────────────
# Só 127.0.0.1: bind público é recusado. Acesso de fora = Tailscale (ver ORION_ALLOWED_HOSTS).
# ORION_HOST=127.0.0.1
# ORION_PORT=8000                  # a porta do legado também é 8000: não suba os dois juntos
# ORION_ALLOW_PUBLIC_BIND=false
# ORION_DATA_DIR=                  # onde ficam orion.db, auth.db, logs (padrão: pasta de dados do usuário)
# ORION_LOG_LEVEL=INFO
# ORION_LOG_JSON=true
# ORION_SERVE_UI=true              # interface em /ui/
# Hosts aceitos no cabeçalho Host. Um host que não seja local (nome do Tailscale) só sobe com login.
# ORION_ALLOWED_HOSTS=["127.0.0.1","localhost"]

# ── login ────────────────────────────────────────────────────────────────────
# Senha: uv run orion set-password (fica em auth.db, fora do backup).
# ORION_AUTH_USER=admin
# Cria o usuário com a SENHA DE FÁBRICA se ainda não há senha (o .exe liga isto). A senha de fábrica está
# num repositório público: troque logo (Configurações › Conexão) e, enquanto ela valer, o Orion recusa
# subir exposto na rede (ORION_ALLOWED_HOSTS de fora).
# ORION_SEED_DEFAULT_PASSWORD=false
# ORION_SESSION_TTL_H=168          # validade da sessão (7 dias)
# ORION_COOKIE_SECURE=false        # true atrás de HTTPS (tailscale serve); em https já é automático
# Credencial de MÁQUINA (scripts, app desktop), 16+ caracteres. Gere com:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# ORION_ADMIN_TOKEN=

# ── modelos ──────────────────────────────────────────────────────────────────
# OmniRoute ou qualquer API compatível com a da OpenAI. Sem URL e modelo, /chat responde 503.
# ORION_GATEWAY_URL=http://127.0.0.1:20128/v1
# ORION_GATEWAY_MODEL=
# ORION_GATEWAY_API_KEY=

# ── ferramentas ──────────────────────────────────────────────────────────────
# Agir no computador (comando, arquivos, documentos, clipboard, notificação, abrir app, git, saúde,
# processos, vigilância). Tudo passa pela política; o que não for leitura segura pede o seu aval.
# ORION_DESKTOP_TOOLS=false
# Web (buscar_url, consultar_clima, pesquisar_com_ia). Desligado por padrão: página lida pode mandar o
# modelo buscar outra URL com dados na query.
# ORION_WEB_TOOLS=false
# ORION_WEATHER_CITY=Marília
# ORION_SEARCH_API_KEY=            # Gemini com Google Search; sem ela vale ORION_EMBED_API_KEY
# ORION_SEARCH_MODEL=gemini-2.5-flash
# Pastas extras onde as ferramentas escrevem sem pedir (ex.: Documents no OneDrive). Lista JSON.
# ORION_EXTRA_SAFE_ROOTS=[]
# Servidores MCP: copie mcp.example.json para <pasta de dados>/mcp.json e rode `uv run orion mcp-check`.
# ORION_MCP_ENABLED=true
# ORION_MCP_CONFIG=                # padrão: <pasta de dados>/mcp.json
# Tempo (s) que uma aprovação de ação fica válida.
# ORION_APPROVAL_TTL_S=600
# Trilha de auditoria das decisões da política (dias).
# ORION_AUDIT_RETENTION_DAYS=90

# ── Telegram ─────────────────────────────────────────────────────────────────
# Sobe com token + IDs permitidos + gateway; sem a lista o bot não sobe (default-deny).
# Pare o bot do legado antes: o Telegram recusa dois clientes no mesmo token.
# ORION_TELEGRAM_TOKEN=
# ORION_TELEGRAM_ALLOWED_USERS=123456789      # ou lista: [123,456]
# Voz: Whisper no Groq (grátis). Sem a chave o bot pede para escrever.
# ORION_TRANSCRIBE_API_KEY=
# ORION_TRANSCRIBE_URL=https://api.groq.com/openai/v1
# ORION_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ── memória e jobs ───────────────────────────────────────────────────────────
# Embeddings pela API gratuita do Gemini. Sem chave a busca é só por palavra-chave.
# ORION_EMBED_API_KEY=
# ORION_EMBED_MODEL=gemini-embedding-001
# ORION_EMBED_DIM=768
# Jobs em segundo plano: lembretes, agendamentos, embeddings, vault, backup, vigilância, processos.
# ORION_JOBS_ENABLED=true
# ORION_JOBS_TICK_S=30
# ORION_CONSOLIDATE=true           # fatos a partir das conversas (precisa do gateway)
# Backup diário (aponte para o iCloud/OneDrive) e vault do Obsidian a indexar.
# ORION_BACKUP_DIR=
# ORION_BACKUP_KEEP=7
# ORION_VAULT_DIR=
